{
  "manifest_version": 3,
  "name": "Aurora Extract \u2014 Facebook, Instagram & TikTok data",
  "version": "0.2.5",
  "description": "Free 3-in-1 extractor: collect public profile, group, Marketplace, post, comment and follower data from Facebook, Instagram and TikTok. Export to CSV, Excel or JSON and download media.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.instagram.com/*",
    "https://*.tiktok.com/*",
    "https://*.fbcdn.net/*",
    "https://*.cdninstagram.com/*",
    "https://*.tiktokcdn.com/*",
    "https://*.tiktokcdn-us.com/*",
    "https://*.tiktokv.com/*",
    "https://*.tiktokcdn-eu.com/*",
    "https://*.tiktokv.us/*",
    "https://*.byteoversea.com/*",
    "https://*.ibytedtos.com/*",
    "https://*.muscdn.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Aurora Extract",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tiktok.com/*"
      ],
      "js": [
        "content/tt-sniffer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.facebook.com/*"
      ],
      "js": [
        "content/fb-sniffer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.instagram.com/*"
      ],
      "js": [
        "content/ig-sniffer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://*.instagram.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": [
        "content/common.js",
        "content/facebook.js",
        "content/instagram.js",
        "content/tiktok.js",
        "content/boot.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
